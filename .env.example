# UMAY AI Agent — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Ollama ─────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ─── Primary Provider ────────────────────────────────────────────────────────
# Which LLM provider to use as primary: OLLAMA, MIMO, DEEPSEEK, etc.
# Default: OLLAMA (local). Set to MIMO to use MiMo as primary.
PRIMARY_PROVIDER=OLLAMA

# ─── MiMo / OpenAI-Compatible Provider (Optional) ───────────────────────────
# Works with any OpenAI-compatible API: MiMo, DeepSeek, GPT, Claude, etc.
# Set PRIMARY_PROVIDER=MIMO to use as primary, or PROVIDER_REASONING=MIMO
# to use only for reasoning tasks.
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=

# ─── DeepSeek (Optional) ────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ─── Extra Providers (comma-separated) ──────────────────────────────────────
# EXTRA_PROVIDERS=MIMO,DEEPSEEK
EXTRA_PROVIDERS=

# ─── Task-specific Provider Overrides ────────────────────────────────────────\# Use different providers for different tasks:
# PROVIDER_REASONING=MIMO
# PROVIDER_CODING=OLLAMA
# PROVIDER_CHAT=OLLAMA

# ─── UMAY Mode ──────────────────────────────────────────────────────────────
# auto_fix: All tools run without approval (development mode)
# approval: Write/execute tools require user approval
UMAY_MODE=approval

# ─── UMAY Secret ────────────────────────────────────────────────────────────
UMAY_SECRET_KEY=change-me-local-only

# ─── Telegram (Optional) ────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram and paste the token here.
# Leave empty to disable Telegram integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# ─── Telegram User Account (MTProto, optional) ─────────────────────────────
# Get API ID and API hash from https://my.telegram.org.
# Never commit these values or a generated session file.
TELEGRAM_USER_API_ID=
TELEGRAM_USER_API_HASH=
TELEGRAM_USER_ALLOWED_USER_ID=
TELEGRAM_USER_ALLOWED_CHAT_ID=
TELEGRAM_USER_SESSION_PATH=telegram_user_sessions/umay_user
