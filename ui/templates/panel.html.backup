<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UMAY Kontrol Paneli</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.2/socket.io.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0a0a0f;
      --panel: #111118;
      --border: #1e1e2e;
      --accent: #7c3aed;
      --accent2: #06b6d4;
      --green: #10b981;
      --orange: #f59e0b;
      --red: #ef4444;
      --text: #e2e8f0;
      --muted: #64748b;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* ─── Üst Bar ─── */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 20px;
      background: var(--panel);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      font-size: 18px;
    }

    .logo span { color: var(--accent); }

    .status-badge {
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      background: #1e1e2e;
      border: 1px solid var(--border);
      transition: all 0.3s;
    }

    .status-badge.green { color: var(--green); border-color: var(--green); }
    .status-badge.blue { color: var(--accent2); border-color: var(--accent2); }
    .status-badge.orange { color: var(--orange); border-color: var(--orange); }
    .status-badge.gray { color: var(--muted); border-color: var(--muted); }

    /* ─── URL Bar ─── */
    .urlbar {
      display: flex;
      gap: 8px;
      padding: 8px 20px;
      background: var(--panel);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .urlbar input {
      flex: 1;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 14px;
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      outline: none;
      transition: border-color 0.2s;
    }

    .urlbar input:focus { border-color: var(--accent); }

    .btn {
      padding: 8px 16px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-weight: 600;
      font-size: 13px;
      transition: all 0.2s;
    }

    .btn-go { background: var(--accent); color: white; }
    .btn-go:hover { background: #6d28d9; }
    .btn-stop { background: var(--orange); color: #000; }
    .btn-stop:hover { background: #d97706; }
    .btn-resume { background: var(--green); color: #000; }
    .btn-resume:hover { background: #059669; }
    .btn-close { background: var(--red); color: white; }
    .btn-close:hover { background: #dc2626; }

    /* ─── Ana Grid ─── */
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 220px;
      gap: 1px;
      background: var(--border);
      flex: 1;
      overflow: hidden;
    }

    .panel {
      background: var(--panel);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .panel-header {
      padding: 8px 14px;
      background: #0d0d15;
      border-bottom: 1px solid var(--border);
      font-size: 11px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .dot {
      width: 6px; height: 6px;
      border-radius: 50%;
    }

    /* ─── Panel 1: Chat ─── */
    .chat-panel { grid-column: 1; grid-row: 1; }

    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .msg {
      max-width: 85%;
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 13px;
      line-height: 1.5;
    }

    .msg-user {
      align-self: flex-end;
      background: var(--accent);
      color: white;
      border-bottom-right-radius: 4px;
    }

    .msg-umay {
      align-self: flex-start;
      background: #1a1a2e;
      border: 1px solid var(--border);
      border-bottom-left-radius: 4px;
    }

    .msg-model {
      font-size: 10px;
      color: var(--accent2);
      margin-top: 4px;
    }

    .chat-input {
      display: flex;
      gap: 8px;
      padding: 10px 14px;
      border-top: 1px solid var(--border);
      flex-shrink: 0;
    }

    .chat-input input {
      flex: 1;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 12px;
      color: var(--text);
      font-size: 13px;
      outline: none;
    }

    .chat-input input:focus { border-color: var(--accent); }

    .btn-send {
      background: var(--accent);
      color: white;
      border: none;
      border-radius: 8px;
      padding: 8px 16px;
      cursor: pointer;
      font-weight: 600;
      font-size: 13px;
    }

    /* ─── Panel 2: Browser ─── */
    .browser-panel { grid-column: 2; grid-row: 1; }

    .browser-screen {
      flex: 1;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000;
      position: relative;
    }

    .browser-screen img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .no-screen {
      color: var(--muted);
      text-align: center;
      font-size: 13px;
    }

    .no-screen .icon { font-size: 48px; margin-bottom: 10px; }

    /* ─── Panel 3: Analiz ─── */
    .analiz-panel { grid-column: 1; grid-row: 2; }

    .analiz-icerik {
      flex: 1;
      overflow-y: auto;
      padding: 10px 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--text);
    }

    .analiz-item {
      margin-bottom: 6px;
      padding: 4px 8px;
      background: #0d0d15;
      border-radius: 4px;
      border-left: 2px solid var(--accent2);
    }

    /* ─── Panel 4: Log ─── */
    .log-panel { grid-column: 2; grid-row: 2; }

    .log-icerik {
      flex: 1;
      overflow-y: auto;
      padding: 10px 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: #a0aec0;
    }

    .log-satir { margin-bottom: 2px; }
    .log-ok { color: var(--green); }
    .log-err { color: var(--red); }
    .log-info { color: var(--accent2); }

    /* ─── Scroll ─── */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

    /* ─── Loading ─── */
    .typing {
      display: inline-flex;
      gap: 4px;
      padding: 6px 10px;
    }

    .typing span {
      width: 6px; height: 6px;
      background: var(--muted);
      border-radius: 50%;
      animation: bounce 1.2s infinite;
    }

    .typing span:nth-child(2) { animation-delay: 0.2s; }
    .typing span:nth-child(3) { animation-delay: 0.4s; }

    @keyframes bounce {
      0%, 60%, 100% { transform: translateY(0); }
      30% { transform: translateY(-6px); }
    }
  </style>
</head>
<body>

<!-- ─── Üst Bar ─── -->
<div class="topbar">
  <div class="logo">
    🤖 <span>UMAY</span> Kontrol Paneli
  </div>
  <div id="statusBadge" class="status-badge green">Hazır</div>
</div>

<!-- ─── URL Bar ─── -->
<div class="urlbar">
  <input type="text" id="urlInput" placeholder="https://www.example.com" value="https://www.google.com"/>
  <button class="btn btn-go" onclick="siteGit()">🌐 Git</button>
  <button class="btn btn-stop" onclick="durdur()">⏸ Durdur</button>
  <button class="btn btn-resume" onclick="devam()">▶ Devam</button>
  <button class="btn btn-close" onclick="tarayiciKapat()">✕ Kapat</button>
</div>

<!-- ─── Ana Grid ─── -->
<div class="grid">

  <!-- Panel 1: Chat -->
  <div class="panel chat-panel">
    <div class="panel-header">
      <div class="dot" style="background:#7c3aed"></div>
      UMAY CHAT
    </div>
    <div class="chat-messages" id="chatMessages">
      <div class="msg msg-umay">
        Merhaba! Ben UMAY. Sol üstten siteye gidebilirsin, ya da benimle konuşabilirsin.
      </div>
    </div>
    <div class="chat-input">
      <input type="text" id="chatInput" placeholder="UMAY'a bir şey sor..." onkeypress="enterChat(event)"/>
      <button class="btn-send" onclick="chatGonder()">Gönder</button>
    </div>
  </div>

  <!-- Panel 2: Browser Canlı -->
  <div class="panel browser-panel">
    <div class="panel-header">
      <div class="dot" style="background:#06b6d4"></div>
      TARAYICI — CANLI GÖRÜNÜM
    </div>
    <div class="browser-screen" id="browserScreen">
      <div class="no-screen">
        <div class="icon">🖥️</div>
        <div>Henüz tarayıcı açılmadı</div>
        <div style="margin-top:6px;font-size:11px">Bir URL gir ve Git'e bas</div>
      </div>
    </div>
  </div>

  <!-- Panel 3: Analiz -->
  <div class="panel analiz-panel">
    <div class="panel-header">
      <div class="dot" style="background:#10b981"></div>
      SAYFA ANALİZİ
    </div>
    <div class="analiz-icerik" id="analizIcerik">
      <div style="color:#64748b">Sayfa analizi burada görünecek...</div>
    </div>
  </div>

  <!-- Panel 4: Log -->
  <div class="panel log-panel">
    <div class="panel-header">
      <div class="dot" style="background:#f59e0b"></div>
      AKSİYON LOGU
    </div>
    <div class="log-icerik" id="logIcerik">
      <div class="log-satir log-info">[UMAY] Panel başlatıldı</div>
    </div>
  </div>

</div>

<script>
const socket = io();
const chatMessages = document.getElementById("chatMessages");
const logIcerik = document.getElementById("logIcerik");
const browserScreen = document.getElementById("browserScreen");
const analizIcerik = document.getElementById("analizIcerik");
const statusBadge = document.getElementById("statusBadge");

// ─── Socket Olaylar ───

socket.on("screenshot", (veri) => {
  browserScreen.innerHTML = `<img src="data:image/png;base64,${veri.img}" alt="browser"/>`;
});

socket.on("log", (veri) => {
  const satirlar = veri.metin.split("\n").filter(s => s.trim());
  satirlar.forEach(s => {
    const div = document.createElement("div");
    div.className = "log-satir " + (s.includes("TAMAM") || s.includes("[OK]") ? "log-ok" :
                                     s.includes("HATA") || s.includes("Hata") ? "log-err" : "log-info");
    div.textContent = s;
    logIcerik.appendChild(div);
  });
  logIcerik.scrollTop = logIcerik.scrollHeight;
});

socket.on("durum", (veri) => {
  statusBadge.textContent = veri.mesaj;
  statusBadge.className = "status-badge " + (veri.renk || "green");
});

socket.on("analiz", (veri) => {
  let html = `<div class="analiz-item"><b>📄 ${veri.baslik}</b></div>`;
  html += `<div class="analiz-item">🔗 ${veri.url}</div>`;
  if (veri.formlar && veri.formlar.length) {
    html += `<div class="analiz-item"><b>📝 Formlar (${veri.formlar.length}):</b><br>`;
    veri.formlar.forEach(f => {
      html += `&nbsp;&nbsp;${f.tag} type="${f.type}" name="${f.name}" placeholder="${f.placeholder}"<br>`;
    });
    html += `</div>`;
  }
  if (veri.linkler && veri.linkler.length) {
    html += `<div class="analiz-item"><b>🔗 Linkler:</b><br>`;
    veri.linkler.forEach(l => {
      html += `&nbsp;&nbsp;<a href="#" style="color:#06b6d4">${l.text || l.href}</a><br>`;
    });
    html += `</div>`;
  }
  analizIcerik.innerHTML = html;
});

// ─── Fonksiyonlar ───

function siteGit() {
  const url = document.getElementById("urlInput").value.trim();
  if (!url) return;
  logEkle(`🌐 Gidiliyor: ${url}`, "log-info");
  fetch("/api/git", {method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify({url})});
}

function durdur() {
  fetch("/api/durdur", {method:"POST"});
  logEkle("⏸ Agent durduruldu — insan kontrolünde", "log-err");
}

function devam() {
  fetch("/api/devam", {method:"POST"});
  logEkle("▶ Agent devam ediyor", "log-ok");
}

function tarayiciKapat() {
  fetch("/api/kapat", {method:"POST"});
  browserScreen.innerHTML = `<div class="no-screen"><div class="icon">🖥️</div><div>Tarayıcı kapatıldı</div></div>`;
  logEkle("✕ Tarayıcı kapatıldı", "log-info");
}

function enterChat(e) {
  if (e.key === "Enter") chatGonder();
}

function chatGonder() {
  const input = document.getElementById("chatInput");
  const soru = input.value.trim();
  if (!soru) return;
  input.value = "";

  // Kullanıcı mesajı
  ekleMsg(soru, "user");

  // Loading
  const loadDiv = document.createElement("div");
  loadDiv.className = "msg msg-umay";
  loadDiv.innerHTML = `<div class="typing"><span></span><span></span><span></span></div>`;
  chatMessages.appendChild(loadDiv);
  chatMessages.scrollTop = chatMessages.scrollHeight;

  fetch("/api/chat", {
    method: "POST",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify({soru})
  })
  .then(r => r.json())
  .then(veri => {
    loadDiv.remove();
    const div = document.createElement("div");
    div.className = "msg msg-umay";
    div.innerHTML = `${veri.cevap}<div class="msg-model">⚡ ${veri.model} [${veri.gorev}]</div>`;
    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  })
  .catch(() => { loadDiv.remove(); });
}

function ekleMsg(metin, tip) {
  const div = document.createElement("div");
  div.className = `msg msg-${tip === "user" ? "user" : "umay"}`;
  div.textContent = metin;
  chatMessages.appendChild(div);
  chatMessages.scrollTop = chatMessages.scrollHeight;
}

function logEkle(metin, sinif) {
  const div = document.createElement("div");
  div.className = "log-satir " + sinif;
  div.textContent = `[${new Date().toLocaleTimeString()}] ${metin}`;
  logIcerik.appendChild(div);
  logIcerik.scrollTop = logIcerik.scrollHeight;
}

// Enter ile URL git
document.getElementById("urlInput").addEventListener("keypress", e => {
  if (e.key === "Enter") siteGit();
});
</script>
</body>
</html>
